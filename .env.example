# Шаблон переменных окружения. Скопируй в .env и подставь реальные значения.
# Реальный .env в git НЕ коммитим (см. .gitignore).

# Строка подключения к MySQL, куда пишутся результаты (таблица field_lynx).
# Формат: mysql+asyncmy://{db_user}:{db_password}@{db_host}:{db_port}/{database_name}
DB_URL=mysql+asyncmy://user:password@localhost:3306/database

# TCP-порт, на котором сервис слушает данные от FinishLynx / FieldLynx.
PORT=9090
